# Required: Vercel AI Gateway key (vercel.com -> AI Gateway -> API keys)
AI_GATEWAY_API_KEY=
# Model routed through AI Gateway. Free-tier gateway credits block Anthropic models; gemini-2.5-flash / openai/gpt-5-mini work
LOCALFIT_MODEL=google/gemini-2.5-flash

# Optional: Supabase. Without these the API uses the seeded demo responses in lib/seed.ts
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Where the agent script sends requests (your Vercel URL after deploy)
LOCALFIT_API_URL=http://localhost:3000

# Optional: your booth recorder app (AI Studio export), e.g. http://localhost:3001
# When set, the agent validates against real recorded booth conversations instead of seed data
RECORDER_URL=
